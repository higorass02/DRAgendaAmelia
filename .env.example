# Variáveis do ambiente Docker Compose.
# Copiar para ".env" e ajustar antes de subir o ambiente:
#   cp .env.example .env

# --- Portas expostas no host ---
APP_PORT=8000
FRONTEND_PORT=5173
DB_PORT=3306
PHPMYADMIN_PORT=8080
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MySQL ---
DB_DATABASE=dragenda
DB_USERNAME=dragenda
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=dragenda
RABBITMQ_DEFAULT_PASS=change_me

# --- Build da imagem PHP (uid/gid do host, evita problemas de permissão) ---
WWWUSER=1000
WWWGROUP=1000
