            "post": {
                "tags": [
                    "Patients"
                ],
                "summary": "Cadastra um paciente",
                "operationId": "1c5763b2aa6fe7d167f31b0a017a4ee6",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "cpf",
                                    "phone",
                                    "birth_date"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Maria Silva"
                                    },
                                    "cpf": {
                                        "type": "string",
                                        "example": "111.444.777-35"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "11999998888"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "maria@example.com",
                                        "nullable": true
                                    },
                                    "birth_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1990-05-10"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Paciente criado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Patient"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erro de validação (CPF inválido/duplicado, etc.)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
