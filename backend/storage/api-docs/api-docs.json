                "operationId": "d0a279eaafb72dedad02526abc07baa1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "specialty",
                                    "availabilities"
