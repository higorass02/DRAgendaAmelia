                                                "end_time": {
                                                    "type": "string",
                                                    "example": "18:00"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Profissional criado"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                },
                "security": [
