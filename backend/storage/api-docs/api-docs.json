        "/appointments/{appointment}/reschedule": {
            "post": {
                "tags": [
                    "Appointments"
                ],
                "summary": "Remarca uma consulta confirmada (cria uma nova vinculada)",
                "operationId": "249625c670f640cd5d230ea1adfb9f65",
                "parameters": [
                    {
                        "name": "appointment",
                        "in": "path",
                        "required": true,
                        "schema": {
